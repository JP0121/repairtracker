# MongoDB Atlas connection string (same pattern as news.lapisforge.com)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/repair-tracker

# NextAuth session encryption secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# The deployed URL in production (e.g. https://repairs.lapisforge.com); http://localhost:3000 for dev
NEXTAUTH_URL=http://localhost:3000

# Optional — used only by scripts/seed.mjs to create the first manager login.
# Change the password immediately after first login.
SEED_MANAGER_EMAIL=manager@ubreakifix.local
SEED_MANAGER_PASSWORD=changeme123
